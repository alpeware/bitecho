{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.clojure/core.async {:mvn/version "1.9.829-alpha2"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.clojure/data.fressian {:mvn/version "1.1.0"}
        com.taoensso/nippy {:mvn/version "3.6.0"}
        alpeware/clj-datachannel {:git/url "https://bitecho.org/git/clj-datachannel.git"
                                  :git/sha "cf590af55cebb7e387a567bba7f301695d7cc384"}}
 :aliases {:run {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
                            "--add-exports=java.base/sun.security.tools.keytool=ALL-UNNAMED"
                            "--add-exports=java.base/sun.security.x509=ALL-UNNAMED"]
                 :main-opts ["-m" "bitecho.main"]}
           :light-node {:jvm-opts ["--enable-native-access=ALL-UNNAMED"
                                   "--add-exports=java.base/sun.security.tools.keytool=ALL-UNNAMED"
                                   "--add-exports=java.base/sun.security.x509=ALL-UNNAMED"]
                        :main-opts ["-m" "bitecho.main" "light-node"]}
           :simulate {:extra-paths ["dev"]
                      :jvm-opts ["-XX:+IgnoreUnrecognizedVMOptions" "--sun-misc-unsafe-memory-access=allow"
                                 "--enable-native-access=ALL-UNNAMED"
                                 "--add-exports=java.base/sun.security.tools.keytool=ALL-UNNAMED"
                                 "--add-exports=java.base/sun.security.x509=ALL-UNNAMED"
                                 "-Dclojure.core.async.pool-size=32"]}
           :test {:extra-paths ["test"]
                  :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}
                  :main-opts ["-m" "bitecho.test-runner"]
                  :jvm-opts ["-XX:+IgnoreUnrecognizedVMOptions" "--sun-misc-unsafe-memory-access=allow"
                             "--enable-native-access=ALL-UNNAMED"
                             "--add-exports=java.base/sun.security.tools.keytool=ALL-UNNAMED"
                             "--add-exports=java.base/sun.security.x509=ALL-UNNAMED"]}
           :test-cljs {:extra-paths ["test"]
                       :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                                    org.clojure/test.check {:mvn/version "1.1.1"}}
                       :main-opts ["-m" "bitecho.cljs-runner"]}
           :build-browser {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
           :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.01.19"}
                                 org.clojure/test.check {:mvn/version "1.1.1"}}
                  :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "dev/bitecho/simulator"]}
           :format {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.1"}}
                    :main-opts ["-m" "cljfmt.main" "fix" "src" "test" "dev/bitecho/simulator"]}
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}}
                   :ns-default build}}}
