 ;; 1. Framing, SLA Target & Codified Process Gate
 ;; ============================================================================
 :framing
 {:goal "Industry-leading DevOps for managing our own infrastructure — far above and beyond any competing network."
  :sla-target {:availability 0.999999
               :name "six nines, in line with mission-critical aviation/defense networks"
               :downtime-budget {:per-year-seconds 31.6
                                 :per-month-seconds 2.63
                                 :deploy-attributable-seconds 0}}
  :process-gate "Codified sociocratic consent round (no paramount objections by anyone in the circle) + simulation-gated deployment + automatic mechanical gate rollback feeding back into the in-memory test suite."
  :moat "SLA + Release Velocity, computed directly from hash-chained on-network audit trails and verifiable by any third party from network storage alone."}

 ;; ============================================================================
 ;; 2. Architectural Pillars & Deliverables (P-DEPLOY-1..P-DEPLOY-9)
 ;; ============================================================================
 :bip/pillars
 {:P-DEPLOY-1
  {:title "Config-as-Pointers with Atomic Epoch-Boundary Activation"
   :files ["src/bitecho/deploy/core.cljc"
           "src/bitecho/state_machine.cljc"
           "src/bitecho/shell/infra.clj"]
   :changes
   ["Define hybrid per-network config pointer schema (`config/<network>/active.edn`) carrying `:seq`, `:activate-at-epoch`, `:code-target-cid`, `:domains` (`:consensus`, `:economy`, `:transport`, `:storage`), `:policy-theta`, `:author-pubkey`, and `:signature`."
    "Implement pure `deploy/stage-config-pointer` and `deploy/apply-epoch-boundary-configs` (wired into `state-machine/handle-tick`) activating staged configs atomically at `new-epoch == :activate-at-epoch` and emitting counted `:config-activation-missed` `:diagnose` effects if missed (Rule 5)."]}

  :P-DEPLOY-2
  {:title "Code-as-Pointers: Two-Stage Self-Update & Verification Before Switch"
   :files ["src/bitecho/deploy/core.cljc"]
   :changes
   ["Implement pure `deploy/verify-and-stage-code-switch` verifying content-addressed SHA-256 (`target-cid == sha256(artifact-bytes)`) and release authority signature chained to `ratified-bip-cid`; refuse switch and emit counted `:code-verification-failed` `:diagnose` on any mismatch (Rule 5)."]}

  :P-DEPLOY-3
  {:title "Zero-Downtime Rolling Upgrades: Subset-First, Epoch-Gated, Automatic Halt & Rollback"
   :files ["src/bitecho/deploy/core.cljc"]
   :changes
   ["Implement pure generation-tagged rollout state machine `deploy/transition-rollout` (`:canary -> :minority -> :remainder -> :completed`) with gate window `W = 8` epochs."
    "Evaluate mechanical gate criteria (0 finalization stall, 100% delivery continuity, full stage attestation); on any gate failure, automatically halt and roll back to `:last-known-good-code-cid` and `:last-known-good-config-hash`, emit counted `:rollout-gate-failed-auto-rollback` `:diagnose`, and emit `:regression-seed-capture`."]}

  :P-DEPLOY-4
  {:title "Simulation-Gated Deployment Simulator"
   :files ["src/bitecho/deploy/core.cljc"]
   :changes
   ["Implement pure deterministic `deploy/simulate-rollout-plan` executing rollout plans across a 6-validator mixed-runtime cluster under nominal and fault-injected schedules (`:node-crash-mid-switch`, `:gate-epoch-partition`, `:corrupt-artifact-hash`, `:byzantine-wrong-code-hash`), proving quorum (`>= 4/6`) and delivery (`100%`) preservation and deterministic replay from seed."]}

  :P-DEPLOY-5
  {:title "Full Hash-Chained On-Network Audit Trail"
   :files ["src/bitecho/deploy/core.cljc"]
   :changes
   ["Implement signed, hash-chained deployment audit records (`deploy/append-audit-record`, `deploy/verify-audit-record`) and pure history reconstruction (`deploy/reconstruct-cluster-history-from-audit-trail`) answering for any query epoch what code, config, and authorizing BIP every node ran."]}

  :P-DEPLOY-6
  {:title "Runtime Diversity as a Deployment Property (JVM & Node.js)"
   :files ["src/bitecho/deploy/core.cljc"]
   :changes
   ["Implement `deploy/order-rollout-stages-mixed-runtime` interleaving `:jvm` and `:nodejs` validators across `:canary`, `:minority`, and `:remainder` stages so runtime-specific regressions are caught before taking a homogeneous cluster."]}

  :P-DEPLOY-7
  {:title "Control-Plane Transport Redundancy & Exhausted-Transport Diagnostics"
   :files ["src/bitecho/deploy/core.cljc"
           "src/bitecho/shell/light_node.clj"]
   :changes
   ["Implement pure `deploy/route-control-plane-envelope` and wire into `bitecho.shell.light-node/handle-serve-line!` so control-plane envelopes mirror across `:validator-udp` and `:https-relay`, succeeding if any single transport delivers and emitting counted `:control-plane-transports-exhausted` `:diagnose` when all tried transports fail (Rule 5)."]}

  :P-DEPLOY-8
  {:title "Six-Nines SLA & Release Velocity Instrumentation from Audit Trail"
   :files ["src/bitecho/deploy/core.cljc"]
   :changes
   ["Implement pure `deploy/compute-sla-and-velocity-report` and `deploy/verify-epoch-sla-checkpoint` computing rolling 30-day availability against `0.999999` (`0` deploy-attributable downtime budget) and per-stage release velocity cycle times (`:ratified-to-implemented-ms`, `:implemented-to-sim-verified-ms`, `:sim-verified-to-rollout-start-ms`, `:rollout-duration-ms`, `:total-ratified-to-live-ms`)."]}

  :P-DEPLOY-9
  {:title "Monte Carlo Tokenomics v2.1 Theta* Config-Pointer Activation & Balance-Preserving Genesis Reset"
   :files ["src/bitecho/config.cljc"
           "src/bitecho/deploy/core.cljc"
           "src/bitecho/state_machine.cljc"
           "src/bitecho/light_node/core.cljc"]
   :changes
   ["Record selected Pareto-optimal `ratified-theta-star` and `ratified-theta-star-metrics` in `bitecho.config` and `bitecho.deploy.core`."
    "Implement `deploy/execute-balance-preserving-genesis-reset` and `deploy/validate-envelope-network-generation` verifying 2f+1 quorum reset pointers and SHA-256 preserved-accounts blobs, incrementing `:network-generation`, resetting `:epoch` to `0`, and preserving exact account balances."
    "Update `bitecho.light-node.core/handle-wire-chain-state-snapshot` and `apply-verified-chain-state-snapshot` to automatically re-baseline local `:epoch` and account `:seq` on `:network-generation` increment while preserving local identity, petnames, and open E2EE sessions."]}}

