 :failure-classifications [{:id "F-1"
                            :phase :chroot-prep
                            :symptom "java: error while loading shared libraries: libjli.so: cannot open shared object file"
                            :classification :procedure-bug
                            :root-cause "Gentoo Hardened toolchain enables insecure-RUNPATH filtering unless /proc is mounted inside the chroot so the dynamic linker can resolve $ORIGIN/../lib via /proc/self/exe."
                            :fix "Mount /proc, /sys, /dev, /run before running chroot verification; after real boot into Gentoo OpenRC, /proc is mounted by procfs service and java works natively."}
                           {:id "F-2"
                            :phase :pivot
                            :symptom "sudo: you do not exist in the passwd database after swapping /etc"
                            :classification :procedure-bug
                            :root-cause "Executing multiple sudo commands sequentially in a non-root shell fails once /etc is swapped if the unprivileged user's UID or sudoers config changes between Debian and Gentoo."
                            :fix "Execute the entire pivot atomically inside a single root process (sudo python3 -c ...)."}
                           {:id "F-3"
                            :phase :pivot
                            :symptom "/bin/sh: /gentoo/usr/bin/mv: not found (or ld-linux-x86-64.so.2 missing) after mv /usr /debian.old/usr"
                            :classification :procedure-bug
                            :root-cause "Both Debian 12 and Gentoo stage3 use merged-/usr where /lib64 -> usr/lib64 and Debian's /usr/lib64/ld-linux-x86-64.so.2 is an absolute symlink to /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2. Moving /usr away first breaks the ELF interpreter path for any subsequent dynamically linked subprocess."
                            :fix "Use the Linux renameat2(AT_FDCWD, \"/usr\", AT_FDCWD, \"/gentoo/usr\", RENAME_EXCHANGE) syscall (syscall 316, flags=2) inside a single root Python process so /usr and /gentoo/usr are exchanged atomically in the kernel VFS with zero window where /lib64/ld-linux-x86-64.so.2 is absent."}
                           {:id "F-4"
                            :phase :openrc-daemon
                            :symptom "bitecho-light-node service marked [ crashed ] under OpenRC start-stop-daemon --background"
                            :classification :procedure-bug
                            :root-cause "bitecho-light-node.cjs serve attaches a readline interface to process.stdin and exits cleanly on stdin EOF; start-stop-daemon --background redirects stdin to /dev/null (immediate EOF), and /sbin/openrc-run uses POSIX /bin/sh where bash process substitution < <(...) is invalid."
                            :fix "Use a POSIX /bin/sh wrapper (/usr/local/bin/bitecho-light-node-daemon) that pipes tail -f /dev/null into exec node /opt/bitecho/bitecho-light-node.cjs \"$@\", keeping stdin open."}]}
