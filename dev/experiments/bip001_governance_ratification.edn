{:experiment-id "bip001-governance-ratification-01"
 :max-turns 2
 :min-echo-balance 100
 :live-network? true
 :bootstrap-path "devnet/bootstrap.edn"
 :fund-from-state-dir "/tmp/antigravity-light-node"
