{:experiment-id "sociocratic-subnet-demo-01"
 :max-turns 2
 :min-echo-balance 100
 :dns-records {"bitecho.org" "35.212.172.159"
               "*.bitecho.org" "35.209.253.119"}
 :nodes
 [{:node-id :alpha-coordinator
   :parent-id :genesis-custody
   :start-balance 5000
   :model-type "gemini-4-hydrogen-low"
   :initial-prompt "You are light node :alpha-coordinator. Run these exact shell commands using the bash tool: 1) `bitecho-node subnet-join sociocratic-lab`, 2) `bitecho-node subnet-broadcast sociocratic-lab \"Proposal: beta-worker compute SHA-256 verification digest for 400 ECH\"`, 3) `bitecho-node transfer beta-worker 400`, and 4) `bitecho-node halt accomplished-goal \"Coordinated subnet proposal and transferred 400 ECH bounty\"`."
